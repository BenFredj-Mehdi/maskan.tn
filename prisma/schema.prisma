// Maskan — plateforme de logement étudiant
// Schéma Prisma — SQLite en dev, migrable vers PostgreSQL en prod (changer "provider")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  OWNER
  ADMIN
}

enum PropertyType {
  STUDIO
  APARTMENT
  ROOM
  SHARED
  HOUSE
}

enum VisitStatus {
  PENDING
  ACCEPTED
  REFUSED
  CANCELLED
}

enum PlanTargetRole {
  STUDENT
  OWNER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile StudentProfile?
  ownerProfile   OwnerProfile?

  subscriptions Subscription[]

  @@index([role])
}

model University {
  id        String   @id @default(cuid())
  name      String
  city      String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  students   StudentProfile[]
  properties Property[]
}

model StudentProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])

  favorites    Favorite[]
  visits       Visit[]
  phoneReveals PhoneReveal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OwnerProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicName String?
  bio        String?

  properties Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id            String       @id @default(cuid())
  ownerId       String
  owner         OwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title         String
  description   String
  price         Float
  type          PropertyType @default(APARTMENT)
  rooms         Int          @default(1)
  beds          Int          @default(1)
  surface       Float?
  address       String
  lat           Float
  lng           Float
  amenities     String       @default("[]") // JSON string array
  isActive      Boolean      @default(true)
  isAvailable   Boolean      @default(true)
  viewsCount    Int          @default(0)
  universityId  String?
  university    University?  @relation(fields: [universityId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  photos       PropertyPhoto[]
  visits       Visit[]
  favorites    Favorite[]
  phoneReveals PhoneReveal[]

  @@index([ownerId])
  @@index([isActive, isAvailable])
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  order      Int      @default(0)
}

model Visit {
  id             String      @id @default(cuid())
  propertyId     String
  property       Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedDate  DateTime
  requestedTime  String
  status         VisitStatus @default(PENDING)
  message        String?
  ownerNote      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([studentId])
  @@index([propertyId])
  @@index([status])
}

model Favorite {
  id         String   @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([studentId, propertyId])
}

model PhoneReveal {
  id         String   @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([studentId, propertyId])
}

// Abonnements 100% configurables depuis le dashboard admin — aucune limite en dur dans le code
model SubscriptionPlan {
  id               String         @id @default(cuid())
  name             String
  targetRole       PlanTargetRole
  price            Float          @default(0)
  durationDays     Int            @default(30)
  maxProperties    Int?           // null = illimité
  maxPhoneReveals  Int?           // null = illimité
  maxVisits        Int?           // null = illimité
  features         String         @default("[]") // JSON string array de libellés
  isActive         Boolean        @default(true)
  isDefault        Boolean        @default(false)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId     String
  plan       SubscriptionPlan @relation(fields: [planId], references: [id])
  startDate  DateTime         @default(now())
  endDate    DateTime?
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())

  @@index([userId])
}
